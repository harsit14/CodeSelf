{"task_id": "codeself-debug/sum-list", "source": "codeself-debug", "prompt": "Write a function sum_list(numbers) that returns the sum of a list of integers. Return 0 for an empty list.", "split": "train", "entry_point": "sum_list", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert sum_list([1, 2, 3]) == 6", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert sum_list([]) == 0", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert sum_list([-1, 1]) == 0", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert sum_list([10]) == 10", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert sum_list([5, 5, 5, 5]) == 20", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "easy"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "easy"}}
{"task_id": "codeself-debug/is-even", "source": "codeself-debug", "prompt": "Write a function is_even(n) that returns True if the integer n is even and False otherwise.", "split": "train", "entry_point": "is_even", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert is_even(2) is True", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert is_even(3) is False", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert is_even(0) is True", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert is_even(-4) is True", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert is_even(-7) is False", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "easy"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "easy"}}
{"task_id": "codeself-debug/reverse-string", "source": "codeself-debug", "prompt": "Write a function reverse_string(s) that returns the reversed version of the string s.", "split": "train", "entry_point": "reverse_string", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert reverse_string('abc') == 'cba'", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert reverse_string('') == ''", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert reverse_string('a') == 'a'", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert reverse_string('racecar') == 'racecar'", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert reverse_string('Hello') == 'olleH'", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "easy"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "easy"}}
{"task_id": "codeself-debug/max-of-list", "source": "codeself-debug", "prompt": "Write a function max_of_list(numbers) that returns the largest number in a non-empty list.", "split": "train", "entry_point": "max_of_list", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert max_of_list([1, 2, 3]) == 3", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert max_of_list([5]) == 5", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert max_of_list([-3, -1, -2]) == -1", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert max_of_list([0, 0, 0]) == 0", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert max_of_list([7, 3, 9, 2]) == 9", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "easy"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "easy"}}
{"task_id": "codeself-debug/count-vowels", "source": "codeself-debug", "prompt": "Write a function count_vowels(s) that returns the number of vowels (a, e, i, o, u, case-insensitive) in the string s.", "split": "train", "entry_point": "count_vowels", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert count_vowels('hello') == 2", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert count_vowels('xyz') == 0", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert count_vowels('AEIOU') == 5", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert count_vowels('') == 0", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert count_vowels('Programming') == 3", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "medium"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "medium"}}
{"task_id": "codeself-debug/factorial", "source": "codeself-debug", "prompt": "Write a function factorial(n) that returns n! for a non-negative integer n. factorial(0) is 1.", "split": "train", "entry_point": "factorial", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert factorial(3) == 6", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert factorial(0) == 1", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert factorial(1) == 1", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert factorial(5) == 120", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert factorial(6) == 720", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "medium"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "medium"}}
{"task_id": "codeself-debug/fizzbuzz", "source": "codeself-debug", "prompt": "Write a function fizzbuzz(n) that returns 'Fizz' if n is divisible by 3, 'Buzz' if divisible by 5, 'FizzBuzz' if divisible by both, and the string of n otherwise.", "split": "train", "entry_point": "fizzbuzz", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert fizzbuzz(3) == 'Fizz'", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert fizzbuzz(5) == 'Buzz'", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert fizzbuzz(15) == 'FizzBuzz'", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert fizzbuzz(7) == '7'", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert fizzbuzz(30) == 'FizzBuzz'", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-4", "code": "assert fizzbuzz(9) == 'Fizz'", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "medium"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "medium"}}
{"task_id": "codeself-debug/is-palindrome", "source": "codeself-debug", "prompt": "Write a function is_palindrome(s) that returns True if the string s reads the same forwards and backwards, ignoring case.", "split": "train", "entry_point": "is_palindrome", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert is_palindrome('racecar') is True", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert is_palindrome('hello') is False", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert is_palindrome('') is True", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert is_palindrome('Anna') is True", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert is_palindrome('Python') is False", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "medium"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "medium"}}
{"task_id": "codeself-debug/gcd", "source": "codeself-debug", "prompt": "Write a function gcd(a, b) that returns the greatest common divisor of two positive integers a and b.", "split": "train", "entry_point": "gcd", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert gcd(12, 8) == 4", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert gcd(7, 1) == 1", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert gcd(100, 10) == 10", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert gcd(17, 13) == 1", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert gcd(48, 36) == 12", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "medium"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "medium"}}
{"task_id": "codeself-debug/second-largest", "source": "codeself-debug", "prompt": "Write a function second_largest(numbers) that returns the second largest distinct value in a list of at least two distinct integers.", "split": "train", "entry_point": "second_largest", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert second_largest([1, 2, 3]) == 2", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert second_largest([5, 1]) == 1", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert second_largest([3, 3, 2, 1]) == 2", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert second_largest([-1, -2, -3]) == -2", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert second_largest([10, 20, 20, 30]) == 20", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "hard"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "hard"}}
{"task_id": "codeself-debug/flatten", "source": "codeself-debug", "prompt": "Write a function flatten(nested) that takes a list of lists and returns a single flat list with all the elements in order.", "split": "train", "entry_point": "flatten", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert flatten([[1, 2], [3]]) == [1, 2, 3]", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert flatten([]) == []", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert flatten([[], [1]]) == [1]", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert flatten([[1], [2], [3]]) == [1, 2, 3]", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert flatten([['a'], ['b', 'c']]) == ['a', 'b', 'c']", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "hard"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "hard"}}
{"task_id": "codeself-debug/word-frequencies", "source": "codeself-debug", "prompt": "Write a function word_frequencies(text) that returns a dict mapping each whitespace-separated word in text to the number of times it appears.", "split": "train", "entry_point": "word_frequencies", "starter_code": "", "public_tests": [{"name": "public-1", "code": "assert word_frequencies('a b a') == {'a': 2, 'b': 1}", "visibility": "public", "kind": "unit"}, {"name": "public-2", "code": "assert word_frequencies('') == {}", "visibility": "public", "kind": "unit"}], "hidden_tests": [{"name": "hidden-1", "code": "assert word_frequencies('x') == {'x': 1}", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-2", "code": "assert word_frequencies('go go go') == {'go': 3}", "visibility": "hidden", "kind": "unit"}, {"name": "hidden-3", "code": "assert word_frequencies('one two two') == {'one': 1, 'two': 2}", "visibility": "hidden", "kind": "unit"}], "tags": ["debug", "hard"], "resource_limits": {"timeout_seconds": 3.0, "memory_mb": 256}, "metadata": {"difficulty": "hard"}}
